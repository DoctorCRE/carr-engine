{
	"compilerOptions": {
		"target": "esnext",
		"lib": ["esnext"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": ["./worker-configuration.d.ts", "node"],
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"allowImportingTsExtensions": true
	},
	"include": ["src"]
}
