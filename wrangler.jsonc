{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "doctorcre-engine",
	"main": "src/worker.ts",
	"compatibility_date": "2026-11-11",
	"send_metrics": false,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": { "enabled": true, "invocation_logs": false }
	},
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": true,
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"services": [{ "binding": "CARR", "service": "carr-mcp" }],
	"hyperdrive": [
		{ "binding": "DATABASE", "id": "371e07c33382489c9ffc401a05f2358e" }
	],
	"env": {
		"staging": {
			"name": "doctorcre-engine-staging",
			"version_metadata": { "binding": "CF_VERSION_METADATA" },
			"services": [{ "binding": "CARR", "service": "carr-mcp-staging" }]
		}
	}
}
