{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "doctorcre-engine",
	"main": "src/worker.ts",
	"compatibility_date": "2026-11-11",
	"send_metrics": false,
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": true,
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"services": [{ "binding": "CARR", "service": "carr-mcp" }],
	"env": {
		"staging": {
			"name": "doctorcre-engine-staging",
			"version_metadata": { "binding": "CF_VERSION_METADATA" },
			"services": [{ "binding": "CARR", "service": "carr-mcp-staging" }]
		}
	}
}
