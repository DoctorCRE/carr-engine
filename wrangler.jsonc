{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "doctorcre-engine",
	"main": "src/worker.ts",
	"compatibility_date": "2026-11-11",
	"send_metrics": false,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": { "enabled": true, "invocation_logs": false }
	},
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": true,
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"services": [
		{ "binding": "CARR", "service": "carr-mcp" },
		{
			"binding": "CARR_READS",
			"service": "carr-mcp",
			"entrypoint": "ComparisonReads"
		}
	],
	"hyperdrive": [
		{ "binding": "DATABASE", "id": "371e07c33382489c9ffc401a05f2358e" }
	],
	"r2_buckets": [
		{ "binding": "POST_MEDIA", "bucket_name": "doctorcre-post-media" }
	],
	"vars": { "POST_MEDIA_BUCKET": "doctorcre-post-media" },
	"env": {
		"staging": {
			"name": "doctorcre-engine-staging",
			"version_metadata": { "binding": "CF_VERSION_METADATA" },
			"services": [
				{ "binding": "CARR", "service": "carr-mcp-staging" },
				{
					"binding": "CARR_READS",
					"service": "carr-mcp-staging",
					"entrypoint": "ComparisonReads"
				}
			],
			"hyperdrive": [
				{ "binding": "DATABASE", "id": "2894a20af7164fb9ac49d8101bdc1d7f" },
				{
					"binding": "DATABASE_WRITER",
					"id": "a3ea8df2724b46198309bf464bcc89ed"
				}
			],
			"r2_buckets": [
				{
					"binding": "POST_MEDIA",
					"bucket_name": "doctorcre-post-media-staging"
				}
			],
			"vars": { "POST_MEDIA_BUCKET": "doctorcre-post-media-staging" }
		}
	}
}
