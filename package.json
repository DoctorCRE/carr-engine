{
	"name": "doctorcre-engine",
	"private": true,
	"type": "module",
	"scripts": {
		"lint": "biome ci",
		"types": "wrangler types && tsc --noEmit",
		"dead": "knip",
		"test": "node --test \"src/**/*.test.ts\"",
		"build": "wrangler deploy --dry-run --outdir dist",
		"check": "npm run lint && npm run dead && node scripts/database-check.ts && npm run build",
		"fix": "biome check --write",
		"schema:drift": "node scripts/schema-drift.ts",
		"types:db": "kysely-codegen --dialect postgres --include-pattern \"public.*\" --out-file src/database.d.ts"
	},
	"dependencies": {
		"hono": "4.13.18"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@types/node": "26.6.6",
		"@types/pg": "8.23.1",
		"knip": "6.45.1",
		"kysely": "0.29.8",
		"kysely-codegen": "0.20.0",
		"pg": "8.23.1",
		"typescript": "7.0.2",
		"wrangler": "4.160.1"
	}
}
