{
	"name": "doctorcre-engine",
	"private": true,
	"type": "module",
	"scripts": {
		"lint": "biome ci",
		"types": "wrangler types && tsc --noEmit",
		"dead": "knip",
		"test": "node --test \"src/**/*.test.ts\"",
		"build": "wrangler deploy --dry-run --outdir dist",
		"check": "npm run lint && npm run types && npm run dead && npm run test && npm run build",
		"fix": "biome check --write"
	},
	"dependencies": {
		"hono": "4.13.18"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@types/node": "26.6.6",
		"knip": "6.45.1",
		"typescript": "7.0.2",
		"wrangler": "4.160.1"
	}
}
